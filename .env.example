# Server Configuration
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Gemini API Configuration (@google/genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Firebase / Firestore Configuration
# Provide either local emulator host or production credentials
FIREBASE_PROJECT_ID=wastewise-hackathon
# Optional: path to serviceAccountKey.json or inline JSON string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"wastewise-hackathon"}
# Optional: for local emulator: FIRESTORE_EMULATOR_HOST=localhost:8080
