# ============================================================================
# WASTEWISE ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and fill in your credentials.
# Never commit real API keys or service-role tokens to version control.
# ============================================================================

# 1. Google Gemini Multimodal AI (Server-only secret)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"

# 2. Supabase Persistent Database (Optional - falls back to local/in-memory store)
# Public anon key is used for client-scoped RLS queries; service role is server-only.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"

# 3. Administrative Guide Management Secret (Server-only secret)
# Required in the `x-admin-token` header when uploading or activating guides.
WASTEWISE_ADMIN_TOKEN="CHANGE_ME_ADMIN_PASSCODE"

# 4. Security & Upload Limits
MAX_IMAGE_UPLOAD_BYTES="5242880"
RATE_LIMIT_REQUESTS_PER_MINUTE="30"
